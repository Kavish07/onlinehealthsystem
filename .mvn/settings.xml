<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <!--
        Project-local override of the machine's global ~/.m2/settings.xml, whose
        <mirrors> entry routes all of "central" through an internal company Nexus
        (10.0.1.10:8081) that isn't reachable from outside that network. Passed in
        via .mvn/maven.config so builds of this project use public Maven Central
        directly, without touching the global settings used by other projects.
    -->
</settings>
